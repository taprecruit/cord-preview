# Cord configuration for running inside taprecruit-dev-env
# (see docker-compose.dev-env.yml). Based on the `dev` tier of
# scripts/generate-dotenv.cjs, with every AWS-backed secret replaced by a local
# dummy value so no AWS access is needed. Every key listed in
# server/src/config/Env.ts as `required` must be present (empty is allowed).

CORD_TIER='dev'
NODE_ENV='development'
COMMIT_HASH='dev-env'
TZ='America/New_York'
LOGLEVEL='info'
NUM_WORKERS='0'
INCLUDE_SDK_TESTBED='1'

API_SERVER_PORT='8161'
ADMIN_SERVER_PORT='8123'
METRICS_SERVER_PORT='8111'
STATUS_SERVER_PORT='8101'
CONSOLE_SERVER_PORT='8171'
DOCS_SERVER_PORT='8191'

# Shared postgres container from analytics-engine; the role and database are
# created by ops/dev-env-db-init.sh
POSTGRES_HOST='postgres'
POSTGRES_PORT='5432'
POSTGRES_USER='cord'
POSTGRES_PASSWORD='cord'
POSTGRES_DB='cord_db'

# Application seeded by ops/dev-env-start.sh for the local taprecruit-app
DEV_ENV_CUSTOMER_ID='00000000-0000-4000-8000-00000000c0de'
DEV_ENV_APPLICATION_ID='00000000-0000-4000-8000-0000000a99de'
DEV_ENV_APPLICATION_SECRET='dev-env-cord-application-secret-change-me'

REDIS_HOST='cord-redis'
REDIS_PORT='6379'
PREDIS_HOST='cord-redis'
PREDIS_PORT='6379'

TOP_SERVER_HOST='local.cord.com'
APP_SERVER_HOST='local.cord.com:8179'
API_SERVER_HOST='local.cord.com:8161'
API_SERVER_HOST_PRODUCTION='api.cord.com'
ADMIN_SERVER_HOST='local.cord.com:8123'
MARKETING_SERVER_HOST='local.cord.com:8117'
PUBLIC_UPLOADS_HOST='local.cord.com:8147'
CONSOLE_SERVER_HOST='local.cord.com:8171'
CORD_TO_HOST='local.cord.com:8161'
DOCS_SERVER_HOST='local.cord.com:8191'
CLACK_SERVER_HOST='local.cord.com:3000'
COMMUNITY_SERVER_HOST='local.cord.com:3000'
DOCS_AI_CHATBOT_SERVER_HOST='http://localhost:8209'

# Local signing/encryption secrets
JWT_SIGNING_SECRET='SpongeBob_signs_your_jwt'
EMAIL_LINKS_TOKEN_SECRET='Super Secret Secret Squirrel'
OAUTH_STATE_SIGNING_SECRET='dev-env-oauth-state-signing-secret'
SLACK_OAUTH_STATE_SIGNING_SECRET='Rolo is the worlds best sausage!'
ADMIN_TOKEN_SECRET='dev-env-admin-token-secret'
DEV_CONSOLE_CORD_APP_SECRET='dev-env-console-cord-app-secret'
DEMO_APPS_SHARED_SECRET='dev-env-demo-apps-shared-secret'
PLATFORM_SECRETS_ENCRYPTION_KEY='12345678901234567890123456789012'
FILE_PROXY_SIGNING_SECRET_KEY='12345678901234567890123456789012'

# S3 (localstack is not part of dev-env yet, so uploads will not work)
S3_REGION='eu-west-2'
S3_BUCKET='radical-stack-fileuploads-wumx9efffh4z'
S3_PUBLIC_BUCKET='cord-public-uploads'
S3_ENDPOINT='https://local.cord.com:8147'
S3_USE_PATH_BASED_URLS='true'
S3_ACCESS_KEY_ID='s3_access_key'
S3_ACCESS_KEY_SECRET='s3_access_secret'

RESEND_API_KEY='re_llama'
RESEND_WEBHOOK_SECRET='re_webhook_llama'
SENTRY_TRACE_SAMPLE_RATE='0'

# Third-party integrations: not available locally
SLACK_APP_CLIENT_SECRET=''
SLACK_DEV_APP_CLIENT_SECRET=''
SLACK_SIGNING_SECRET=''
SLACK_ADMIN_CLIENT_SECRET=''
SLACK_ADMIN_SIGNING_SECRET=''
SLACK_INTERNAL_BOT_TOKEN=''
SLACK_INTERNAL_SIGNING_SECRET=''
SLACK_CUSTOMER_UPDATES_BOT_TOKEN=''
SLACK_ADMIN_LOGIN_REDIRECT_HOST='admin.staging.cord.com'
SLACK_APP_REDIRECT_HOST='api.staging.cord.com'
JIRA_APP_CLIENT_ID=''
JIRA_APP_CLIENT_SECRET=''
ASANA_APP_CLIENT_ID=''
ASANA_APP_CLIENT_SECRET=''
LINEAR_APP_CLIENT_ID=''
LINEAR_APP_CLIENT_SECRET=''
TRELLO_APP_CLIENT_ID=''
TRELLO_APP_CLIENT_SECRET=''
MONDAY_APP_CLIENT_ID=''
MONDAY_APP_CLIENT_SECRET=''
AUTH0_CLIENT_ID=''
AUTH0_CUSTOM_LOGIN_DOMAIN=''
AUTH0_GENERAL_DOMAIN=''
AUTH0_MTM_CLIENT_ID=''
AUTH0_MTM_CLIENT_SECRET=''
AUTH0_WEBHOOK_SECRET=''
OPENAI_API_SECRET=''
GA_MEASUREMENT_ID=''
GA_MEASUREMENT_PROTOCOL_API_SECRET=''
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET_KEY=''
LOOPS_SO_API_KEY=''
